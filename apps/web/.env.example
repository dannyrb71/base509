# apps/web environment (copy to .env.local — gitignored; set the same in Vercel).
# NEVER accept Supabase URLs/project ids/product keys from client input — these
# are server-configured only (architecture §3.4 hostname/product registry).

# ── Marketing site (prod/waitlist Supabase project — waitlist table only) ────
NEXT_PUBLIC_SUPABASE_URL=https://<prod-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<prod-anon-key>

# ── Provider portal (Phase A — the petappro-dev Supabase project with the
#    CFG-1 schema; NEVER point this at the prod/waitlist project until the
#    gated prod apply happens). anon key is publishable by design; RLS is the
#    security boundary. ─────────────────────────────────────────────────────
NEXT_PUBLIC_PORTAL_SUPABASE_URL=https://<dev-project-ref>.supabase.co
NEXT_PUBLIC_PORTAL_SUPABASE_ANON_KEY=<dev-anon-key>

# Server-only. NOT required by the A1 flow (bootstrap RPCs run as the
# authenticated user); reserved for future machine ops (entitlement sync).
# Never expose with NEXT_PUBLIC_, never commit a real value.
# SUPABASE_SERVICE_ROLE_KEY=<dev-service-role-key>

# ── Marketing extras ─────────────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=<maps-browser-key>
RESEND_API_KEY=<resend-key>
